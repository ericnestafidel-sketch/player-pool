# Player Pool — copy to .env.local for local dev. On Vercel, set these in the
# project (Marketplace installs for Neon and Clerk write the keys for you).
# Do not commit real values. The app builds without them; player pages stay closed.

# Neon Postgres (Vercel Marketplace → Neon).
# Pooled URL used by the running app.
DATABASE_URL=

# Direct/unpooled URL used by `npm run db:migrate` when the pooled URL refuses DDL.
# Optional if DATABASE_URL already works for migrations.
DATABASE_URL_UNPOOLED=

# Clerk (Vercel Marketplace → Clerk).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/continue
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/parent

# Server-only. Comma-separated verified primary emails that become admin.
# Do not use a NEXT_PUBLIC_ name. The list is never sent to the browser.
# Sign up at /sign-up with one of these emails, then open /admin.
ADMIN_EMAILS=

# Optional message notices. Both must be set or email is skipped and logged.
# The email only says there is a new message and links back to the site.
# It does not include the message, a name, or either person's email or phone.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
# Origin for checkout return URLs and message links. When set, this wins over the Vercel host.
# Production: https://player-pool.net
APP_URL=
# Leave unset until parents can list players. true, 1, or yes opens parent sign-up.
# Unset keeps player sign-up closed. Coach sign-up is unaffected. Admins can still add test players.
PLAYER_SIGNUP_OPEN=
# Comma-separated state codes that can list players, apply as coaches, and post on the board.
LAUNCH_STATES=IN,IL,OH

# Stripe Checkout. The app runs without these and shows "Payments coming soon".
# Never put card numbers in Player Pool. npm run stripe:setup creates prices and FIRST25.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Leave unset until launch. true hides unpaid and expired profiles from coach search.
REQUIRE_PAID_LISTING=
# Vercel cron Authorization bearer for /api/cron/season-expire.
CRON_SECRET=
