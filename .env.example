# Player Pool — copy to .env.local for local dev. On Vercel, set these in the
# project (Marketplace installs for Neon and Clerk write the keys for you).
# Do not commit real values. The app builds without them; player pages stay closed.

# Neon Postgres (Vercel Marketplace → Neon).
# Pooled URL used by the running app.
DATABASE_URL=

# Direct/unpooled URL used by `npm run db:migrate` when the pooled URL refuses DDL.
# Optional if DATABASE_URL already works for migrations.
DATABASE_URL_UNPOOLED=

# Clerk (Vercel Marketplace → Clerk).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/continue
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/parent

# Server-only. Comma-separated verified primary emails that become admin.
# Do not use a NEXT_PUBLIC_ name. The list is never sent to the browser.
# Sign up at /sign-up with one of these emails, then open /admin.
ADMIN_EMAILS=

# Public support address shown on the site, used as the contact-form destination,
# and as the recipient for pending-coach alerts. Falls back to coachericllc@gmail.com.
SUPPORT_EMAIL=coachericllc@gmail.com

# Optional email delivery. RESEND_API_KEY and NOTIFY_FROM_EMAIL must both be set
# or sending is skipped and logged. Notices link back to the site and do not include
# message bodies, player data, or either person's email or phone.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
# Origin for checkout return URLs and message links. When set, this wins over the Vercel host.
# Production: https://player-pool.net
APP_URL=
# true, 1, or yes opens parent sign-up for the free first-season offer, while spots remain.
# Unset closes parent sign-up. Coach sign-up is unaffected. Admins can still add test players.
PLAYER_SIGNUP_OPEN=
# Optional cap override for free first-season players. Defaults to 100 (LAUNCH_FREE_SEASON_SPOTS).
# After the cap is reached, parent sign-up shows "full for now" and does not fall back to paid.
# Raise this (and keep PLAYER_SIGNUP_OPEN=true) to reopen more free spots.
# PLAYER_SIGNUP_CAP=100
# Comma-separated state codes that can list players, apply as coaches, and post on the board.
LAUNCH_STATES=IN,IL,OH

# Stripe Checkout stays off until PAID_CHECKOUT_OPEN is set after legal and LLC billing review.
# Never put card numbers in Player Pool.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Leave unset. Paid checkout is disabled in code until this is true, 1, or yes.
# PAID_CHECKOUT_OPEN=
# Leave unset until paid listings launch. true hides unpaid and expired profiles from coach search.
REQUIRE_PAID_LISTING=
# Vercel cron Authorization bearer for /api/cron/season-expire.
CRON_SECRET=
