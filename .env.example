# Player Pool — copy to .env.local for local dev. On Vercel, set these in the
# project (Marketplace installs for Neon and Clerk write the keys for you).
# Do not commit real values. The app builds without them; player pages stay closed.

# Neon Postgres (Vercel Marketplace → Neon).
# Pooled URL used by the running app.
DATABASE_URL=

# Direct/unpooled URL used by `npm run db:migrate` when the pooled URL refuses DDL.
# Optional if DATABASE_URL already works for migrations.
DATABASE_URL_UNPOOLED=

# Clerk (Vercel Marketplace → Clerk).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/continue
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/parent

# Server-only. Comma-separated verified primary emails that become admin.
# Do not use a NEXT_PUBLIC_ name. The list is never sent to the browser.
# Sign up at /sign-up with one of these emails, then open /admin.
ADMIN_EMAILS=

# Optional message notices. Both must be set or email is skipped and logged.
# The email only says there is a new message and links back to the site.
# It does not include the message, a name, or either person's email or phone.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
# Origin for those links, such as https://playerpool.example. On Vercel, VERCEL_URL is used if this is empty.
APP_URL=

# Stripe is intentionally not wired in this session.
